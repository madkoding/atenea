#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
COMPOSE_BASE="docker/compose.yml"
COMPOSE_NVIDIA="docker/compose.gpu-nvidia.yml"
COMPOSE_AMD="docker/compose.gpu-amd.yml"

# ─── styling ───────────────────────────────────────────────────────────────────
C_INFO=$'\033[36m'
C_OK=$'\033[32m'
C_WARN=$'\033[33m'
C_FAIL=$'\033[31m'
C_STEP=$'\033[35m'
C_DIM=$'\033[2m'
C_BOLD=$'\033[1m'
C_RST=$'\033[0m'

_info()   { printf "${C_INFO}ℹ${C_RST}  %s\n" "$*"; }
_ok()     { printf "${C_OK}✔${C_RST}  %s\n" "$*"; }
_warn()   { printf "${C_WARN}⚠${C_RST}  %s\n" "$*"; }
_fail()   { printf "${C_FAIL}✘${C_RST}  %s\n" "$*"; }
_step()   { printf "\n${C_BOLD}${C_STEP}◆${C_RST}  ${C_BOLD}%s${C_RST}\n" "$*"; }
_dim()    { printf "${C_DIM}%s${C_RST}\n" "$*"; }
_sep()    { printf "${C_DIM}──────────────────────────────────────────${C_RST}\n"; }

# ─── spinner ───────────────────────────────────────────────────────────────────
_spin() {
    local msg="$1"; shift
    local spin='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    local i=0 start ms formatted out
    start=$(date +%s%N)
    out=$(mktemp)

    printf '\033[?25l'
    "$@" >"$out" 2>&1 &
    local pid=$!

    while kill -0 "$pid" 2>/dev/null; do
        printf '\r  \033[36m%s\033[0m  %s' "${spin:$i:1}" "$msg"
        i=$(( (i + 1) % ${#spin} ))
        sleep 0.08
    done

    local rc=0
    wait "$pid" 2>/dev/null || rc=$?
    printf '\033[?25h'

    ms=$(( ($(date +%s%N) - start) / 1000000 ))
    if [ "$ms" -ge 1000 ]; then
        formatted="$(awk "BEGIN{printf \"%.1fs\",$ms/1000}")"
    else
        formatted="${ms}ms"
    fi

    if [ "$rc" -eq 0 ]; then
        printf '\r  \033[32m✔\033[0m  %s  \033[2m(%s)\033[0m\n' "$msg" "$formatted"
    else
        printf '\r  \033[31m✘\033[0m  %s  \033[2m(%s)\033[0m\n' "$msg" "$formatted"
        [ -s "$out" ] && sed 's/^/    /' "$out"
        echo
    fi
    rm -f "$out"
    return "$rc"
}

# ─── core helpers ──────────────────────────────────────────────────────────────
_detect_gpu() {
    if command -v nvidia-smi &>/dev/null && nvidia-smi &>/dev/null; then
        echo "nvidia"
    elif [ -e /dev/kfd ] || command -v rocminfo &>/dev/null || command -v hipconfig &>/dev/null; then
        echo "amd"
    else
        echo "cpu"
    fi
}

_env_get() {
    local key="$1"
    local env_file="${REPO_ROOT}/.env"
    [ -f "$env_file" ] || return 1
    awk -F= -v k="$key" '
        $1 == k {
            v = substr($0, index($0, "=") + 1)
            gsub(/^[[:space:]"]+|[[:space:]"]+$/, "", v)
            val = v
        }
        END {
            if (val != "") print val
            else exit 1
        }
    ' "$env_file"
}

_gpu_mode_from_compose_file() {
    local compose_file="$1"
    case "$compose_file" in
        *"gpu.nvidia.yml"*) echo "nvidia" ;;
        *"gpu.amd.yml"*)    echo "amd" ;;
        *)                    echo "" ;;
    esac
}

_docker_has_nvidia_runtime() {
    docker info 2>/dev/null | grep -Eq 'Runtimes:.*\bnvidia\b'
}

_host_amd_devices_ready() {
    [ -e /dev/kfd ] && [ -d /dev/dri ]
}

_auto_gpu_mode() {
    local detected
    detected="$(_detect_gpu)"
    case "$detected" in
        nvidia)
            if _docker_has_nvidia_runtime; then
                echo "nvidia"
            else
                _warn "NVIDIA GPU detected, but Docker nvidia runtime is unavailable. Falling back to CPU."
                _warn "Run scripts/check-docker-gpu.sh to enable NVIDIA Docker passthrough."
                echo "cpu"
            fi
            ;;
        amd)
            if _host_amd_devices_ready; then
                echo "amd"
            else
                _warn "AMD GPU tooling detected, but /dev/kfd or /dev/dri is missing. Falling back to CPU."
                _warn "Run scripts/check-docker-amd-gpu.sh to diagnose AMD Docker passthrough."
                echo "cpu"
            fi
            ;;
        *)
            echo "cpu"
            ;;
    esac
}

_resolve_gpu_mode() {
    local cli_override="${ATENEA_GPU_MODE_OVERRIDE:-}"
    local mode=""
    local compose_file="${COMPOSE_FILE:-}"

    if [ -n "$cli_override" ]; then
        mode="$cli_override"
    elif [ -n "${GPU_MODE:-}" ]; then
        mode="${GPU_MODE}"
    else
        if [ -z "$compose_file" ]; then
            compose_file="$(_env_get COMPOSE_FILE || true)"
        fi
        mode="$(_gpu_mode_from_compose_file "$compose_file")"
        [ -n "$mode" ] || mode="$(_auto_gpu_mode)"
    fi

    case "$mode" in
        nvidia|amd|cpu) echo "$mode" ;;
        *)
            _fail "Unknown GPU mode: ${mode}. Use nvidia, amd, or cpu."
            return 1 ;;
    esac
}

_ensure_env() {
    if [ ! -f "${REPO_ROOT}/.env" ]; then
        _spin "Creating .env from .env.example" \
            cp "${REPO_ROOT}/.env.example" "${REPO_ROOT}/.env"
        _info "Edit .env to configure your instance"
    fi
}

_prepend_ld_path() {
    local path="$1"
    [ -d "$path" ] || return 0
    local current=":${LD_LIBRARY_PATH:-}:"
    if [[ "$current" != *":$path:"* ]]; then
        export LD_LIBRARY_PATH="$path${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    fi
}

_export_venv_cuda_libs() {
    local pyver libbase
    pyver="$(${REPO_ROOT}/.venv/bin/python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null || true)"
    [ -n "$pyver" ] || return 0
    libbase="${REPO_ROOT}/.venv/lib/python${pyver}/site-packages/nvidia"
    _prepend_ld_path "${libbase}/cuda_runtime/lib"
    _prepend_ld_path "${libbase}/cublas/lib"
}

_compose_cmd() {
    local action="$1"; shift
    local gpu
    local compose_args=()

    _ensure_env
    gpu="$(_resolve_gpu_mode)" || return 1

    compose_args+=(-f "${COMPOSE_BASE}")

    case "${gpu}" in
        nvidia)
            _info "GPU mode: NVIDIA"
            compose_args+=(-f "${COMPOSE_NVIDIA}")
            ;;
        amd)
            _info "GPU mode: AMD"
            compose_args+=(-f "${COMPOSE_AMD}")
            ;;
        cpu)
            _info "GPU mode: CPU"
            ;;
    esac

    (cd "${REPO_ROOT}" && docker compose -p atenea "${compose_args[@]}" "$action" "$@")
}

# ─── subcommands ───────────────────────────────────────────────────────────────
_ensure_sysdeps() {
    local pkgs=()
    if ! $PYTHON_BIN -c 'import ensurepip' &>/dev/null; then
        local py_ver
        py_ver="$($PYTHON_BIN -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
        pkgs+=("python${py_ver}-venv")
    fi
    if ! ${PYTHON_BIN}-config --include &>/dev/null 2>&1; then
        pkgs+=(python3-dev)
    fi
    if ! command -v gcc &>/dev/null; then
        pkgs+=(build-essential)
    fi
    if ! command -v git &>/dev/null; then
        pkgs+=(git)
    fi

    [ ${#pkgs[@]} -eq 0 ] && return

    _dim "Installing: ${pkgs[*]}"
    if command -v apt-get &>/dev/null; then
        sudo apt-get update -qq && sudo apt-get install -y -qq "${pkgs[@]}"
    elif command -v dnf &>/dev/null; then
        sudo dnf install -y -q "${pkgs[@]}"
    elif command -v pacman &>/dev/null; then
        sudo pacman -S --noconfirm "${pkgs[@]}"
    elif command -v zypper &>/dev/null; then
        sudo zypper install -y "${pkgs[@]}"
    elif command -v brew &>/dev/null; then
        # On macOS, python3-dev and build-essential are not Homebrew formulae.
        # python3-dev is included in the python formula; build-essential is
        # provided by Xcode CLI tools. Only install git if missing.
        local brew_pkgs=()
        for pkg in "${pkgs[@]}"; do
            case "$pkg" in
                python3-dev|build-essential) ;;
                *) brew_pkgs+=("$pkg") ;;
            esac
        done
        if [ ${#brew_pkgs[@]} -gt 0 ]; then
            brew install "${brew_pkgs[@]}"
        fi
    else
        _warn "Unknown package manager — install manually: ${pkgs[*]}"
    fi
}

_setup() {
    _sep
    printf "${C_BOLD}${C_STEP}  Atenea Setup${C_RST}\n"
    _sep

    # ── 1. Python version ─────────────────────────────────────────────────────
    _step "1/7  Checking Python"
    if ! command -v python3 &>/dev/null; then
        _fail "python3 not found — install Python 3.12 first"
        exit 1
    fi
    PYTHON_BIN="python3"
    py_version="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
    if [ "$py_version" = "3.9" ]; then
        if command -v brew &>/dev/null; then
            _dim "Python 3.9 is too old for some dependencies. Installing Python 3.12 via Homebrew..."
            brew install python@3.12
            BREW_PREFIX="$(brew --prefix python@3.12)"
            PYTHON_BIN="$BREW_PREFIX/bin/python3.12"
            _ok "Python 3.12 installed via Homebrew"
        else
            _fail "Python 3.10+ required (found $py_version) — install Python 3.12 manually"
            exit 1
        fi
    elif [ "$py_version" != "3.12" ]; then
        _warn "Python 3.12 recommended (found $py_version) — continuing"
    else
        _ok "Python $py_version"
    fi

    # ── 2. System dependencies ────────────────────────────────────────────────
    _step "2/7  System dependencies"
    _ensure_sysdeps
    _ok "System dependencies ready"

    # ── 3. Environment file ───────────────────────────────────────────────────
    _step "3/7  Environment file"
    _ensure_env
    _ok "Environment ready"

    # ── 4. Virtual environment ────────────────────────────────────────────────
    _step "4/7  Python virtual environment"
    VENV_PY="${REPO_ROOT}/.venv/bin/python3"
    VENV_PIP="${REPO_ROOT}/.venv/bin/pip"
    RECREATE_VENV=0
    if [ -f "$VENV_PY" ]; then
        venv_ver="$("$VENV_PY" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null)" || venv_ver=""
        py_ver="$($PYTHON_BIN -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
        if [ "$venv_ver" != "$py_ver" ]; then
            _warn "Virtual environment uses Python $venv_ver but system has Python $py_ver — rebuilding"
            RECREATE_VENV=1
        fi
    fi
    if [ ! -f "$VENV_PIP" ] || [ ! -f "$VENV_PY" ] || [ "$RECREATE_VENV" = "1" ]; then
        if [ -d "${REPO_ROOT}/.venv" ]; then
            rm -rf "${REPO_ROOT}/.venv"
        fi
        _spin "Creating virtual environment" $PYTHON_BIN -m venv "${REPO_ROOT}/.venv"
    else
        _ok "Virtual environment exists"
    fi

    # ── 5. Python dependencies ────────────────────────────────────────────────
    _step "5/7  Python dependencies"
    _spin "Upgrading pip" "${VENV_PIP}" install --upgrade pip -q
    _spin "Installing core dependencies" "${VENV_PIP}" install -r "${REPO_ROOT}/requirements.txt" -q
    if [ -f "${REPO_ROOT}/requirements-optional.txt" ]; then
        _spin "Installing optional dependencies" "${VENV_PIP}" install -r "${REPO_ROOT}/requirements-optional.txt" -q
    fi
    _spin "Installing project in dev mode" "${VENV_PIP}" install -e "${REPO_ROOT}" -q

    # ── 6. Application setup ──────────────────────────────────────────────────
    _step "6/7  Application setup"
    _export_venv_cuda_libs
    if ATENEA_SKIP_RUN_HINT=1 "${VENV_PY}" "${REPO_ROOT}/app_setup.py"; then
        _ok "Application setup complete"
    else
        _fail "Application setup failed"
        return 1
    fi

    # ── 7. Auto-start ─────────────────────────────────────────────────────────
    _step "7/7  Starting Atenea"
    if command -v docker &>/dev/null; then
        _up --build
    else
        _warn "Docker not found — skipping container start"
        _info "Install Docker Desktop from ${C_BOLD}https://docs.docker.com/desktop/setup/install/mac-install/${C_RST}"
        _info "Then run:  ${C_BOLD}./atenea up${C_RST}"
        _info ""
        _info "To run without Docker (native mode):"
        _info "  ${C_BOLD}${VENV_PY} -m uvicorn app:app --host 0.0.0.0 --port ${APP_PORT:-7000}${C_RST}"
    fi
}

_wait_for_ready() {
    local host="$1" port="$2"
    local timeout="${ATENEA_WAIT_TIMEOUT:-120}"
    local interval=2 elapsed=0

    while [ "$elapsed" -lt "$timeout" ]; do
        if command -v curl &>/dev/null; then
            curl -sf "http://${host}:${port}/" -o /dev/null 2>/dev/null && return 0
        elif command -v wget &>/dev/null; then
            wget -q "http://${host}:${port}/" -O /dev/null 2>/dev/null && return 0
        else
            (echo > "/dev/tcp/${host}/${port}") 2>/dev/null && return 0
        fi
        sleep "$interval"
        elapsed=$((elapsed + interval))
    done
    return 1
}

_up() {
    local native=0 build=0 gpu_mode="" args=()

    for arg in "$@"; do
        case "$arg" in
            --native)  native=1 ;;
            --build)   build=1 ;;
            --nvidia)  gpu_mode="nvidia" ;;
            --amd)     gpu_mode="amd" ;;
            --cpu)     gpu_mode="cpu" ;;
            *)         args+=("$arg") ;;
        esac
    done

    if [ "$native" -eq 1 ]; then
        _step "Starting Atenea natively"
        _setup
        _export_venv_cuda_libs
        exec "${REPO_ROOT}/.venv/bin/uvicorn" app:app --host 0.0.0.0 --port "${APP_PORT:-7000}" "${args[@]}"
        return
    fi

    [ "$build" -eq 1 ] && args+=(--build)
    ATENEA_GPU_MODE_OVERRIDE="$gpu_mode" _compose_cmd up -d "${args[@]}"

    local port="${APP_PORT:-7000}"
    _spin "Waiting for Atenea to be ready on port ${port}" \
        _wait_for_ready "localhost" "$port"

    _sep
    _ok "Atenea is running"
    _info "Open  ${C_BOLD}http://localhost:${port}${C_RST}  in your browser"
    _info "Run   ./atenea logs  to follow output"
}

_usage() {
    _sep
    printf "${C_BOLD}${C_STEP}  atenea — CLI${C_RST}\n"
    _sep
    printf '\n'
    printf "  ${C_BOLD}Usage:${C_RST}  ${C_BOLD}./atenea <command>${C_RST} [options]\n"
    printf '\n'
    printf "  ${C_BOLD}Commands:${C_RST}\n"
    printf "    setup                  First-time setup (venv, .env, deps)\n"
    printf "    up [options]           Start Atenea (auto-detects GPU)\n"
    printf "      --native               Run directly on host (no Docker)\n"
    printf "      --build                Rebuild Docker image before starting\n"
    printf "      --nvidia | --amd | --cpu   Force GPU mode\n"
    printf '\n'
    printf "    down                   Stop all containers\n"
    printf "    logs [options]         Follow container logs\n"
    printf "    shell                  Open a shell in the running container\n"
    printf "    exec <cmd...>          Run a command in the running container\n"
    printf "    ps                     List running containers\n"
    printf "    help                   Show this help\n"
    printf '\n'
}

# ─── main dispatch ─────────────────────────────────────────────────────────────
cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
    setup)             _setup "$@" ;;
    up)                _up "$@" ;;
    down|stop)         _compose_cmd down "$@" ;;
    logs)              _compose_cmd logs -f "$@" ;;
    shell)             _compose_cmd exec atenea bash "$@" ;;
    exec)              _compose_cmd exec atenea "$@" ;;
    ps)                _compose_cmd ps "$@" ;;
    help|--help|-h)    _usage ;;
    *)                 _fail "Unknown command: $cmd"; _usage; exit 1 ;;
esac
