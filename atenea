#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
COMPOSE_BASE="docker/compose.yml"
COMPOSE_NVIDIA="docker/compose.gpu-nvidia.yml"
COMPOSE_AMD="docker/compose.gpu-amd.yml"

# ─── helpers ───────────────────────────────────────────────────────────────────
_info()  { printf '\033[34m[INFO]\033[0m %s\n' "$*"; }
_ok()    { printf '\033[32m[ OK ]\033[0m %s\n' "$*"; }
_warn()  { printf '\033[33m[WARN]\033[0m %s\n' "$*"; }
_fail()  { printf '\033[31m[FAIL]\033[0m %s\n' "$*"; }
_step()  { printf '\033[36m[STEP]\033[0m %s\n' "$*"; }

_detect_gpu() {
    if command -v nvidia-smi &>/dev/null && nvidia-smi &>/dev/null; then
        echo "nvidia"
    elif [ -e /dev/kfd ]; then
        echo "amd"
    else
        echo "cpu"
    fi
}

_ensure_env() {
    if [ ! -f "${REPO_ROOT}/.env" ]; then
        _step "No .env found — copying from .env.example"
        cp "${REPO_ROOT}/.env.example" "${REPO_ROOT}/.env"
        _ok "Created .env — edit it to configure your instance"
    fi
}

_compose_cmd() {
    # $1 = "up", "down", "logs", "ps", "exec", etc. Remaining args forwarded.
    local action="$1"; shift
    local gpu
    gpu="$(_detect_gpu)"
    local compose_args=()

    _ensure_env

    case "${GPU_MODE:-$gpu}" in
        nvidia)
            _info "GPU mode: NVIDIA"
            compose_args+=(-f "${COMPOSE_NVIDIA}")
            ;;
        amd)
            _info "GPU mode: AMD"
            compose_args+=(-f "${COMPOSE_AMD}")
            ;;
        cpu)
            _info "GPU mode: CPU"
            compose_args+=(-f "${COMPOSE_BASE}")
            ;;
        *)
            _fail "Unknown GPU_MODE: ${GPU_MODE:-auto}. Use nvidia, amd, or cpu."
            return 1
            ;;
    esac

    (cd "${REPO_ROOT}" && docker compose "${compose_args[@]}" "$action" "$@")
}

# ─── subcommands ───────────────────────────────────────────────────────────────

_ensure_sysdeps() {
    local pkgs=()
    if ! python3 -m venv --help &>/dev/null; then
        pkgs+=(python3-venv)
    fi
    if ! python3-config --include &>/dev/null 2>&1; then
        pkgs+=(python3-dev)
    fi
    if ! command -v gcc &>/dev/null; then
        pkgs+=(build-essential)
    fi
    if ! command -v git &>/dev/null; then
        pkgs+=(git)
    fi
    [ ${#pkgs[@]} -eq 0 ] && return

    _step "Installing system dependencies: ${pkgs[*]}"
    if command -v apt-get &>/dev/null; then
        sudo apt-get update -qq && sudo apt-get install -y -qq "${pkgs[@]}"
    elif command -v dnf &>/dev/null; then
        sudo dnf install -y -q "${pkgs[@]}"
    elif command -v pacman &>/dev/null; then
        sudo pacman -S --noconfirm "${pkgs[@]}"
    elif command -v zypper &>/dev/null; then
        sudo zypper install -y "${pkgs[@]}"
    elif command -v brew &>/dev/null; then
        brew install "${pkgs[@]}"
    else
        _warn "Unknown package manager — install manually: ${pkgs[*]}"
    fi
    _ok "System dependencies installed"
}

_setup() {
    _step "Atenea first-time setup"

    # 1. Check Python version
    if ! command -v python3 &>/dev/null; then
        _fail "python3 not found — install Python 3.12 first"
        exit 1
    fi
    py_version="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
    if [ "$py_version" != "3.12" ]; then
        _warn "Python 3.12 recommended (found $py_version) — continuing anyway"
    fi

    # 2. System dependencies (python3-venv, build-essential, etc.)
    _ensure_sysdeps

    # 3. .env
    _ensure_env

    # 4. Virtual environment (rebuild if broken)
    VENV_PY="${REPO_ROOT}/.venv/bin/python3"
    VENV_PIP="${REPO_ROOT}/.venv/bin/pip"
    if [ ! -f "$VENV_PIP" ] || [ ! -f "$VENV_PY" ]; then
        if [ -d "${REPO_ROOT}/.venv" ]; then
            _warn "Virtual environment is broken — rebuilding"
            rm -rf "${REPO_ROOT}/.venv"
        fi
        _step "Creating Python virtual environment"
        python3 -m venv "${REPO_ROOT}/.venv"
        _ok "Virtual environment created"
    fi

    # 5. Python dependencies
    _step "Installing Python dependencies"
    "${REPO_ROOT}/.venv/bin/pip" install --upgrade pip -q
    "${REPO_ROOT}/.venv/bin/pip" install -r "${REPO_ROOT}/requirements.txt" -q
    if [ -f "${REPO_ROOT}/requirements-optional.txt" ]; then
        "${REPO_ROOT}/.venv/bin/pip" install -r "${REPO_ROOT}/requirements-optional.txt" -q
    fi
    _ok "Python dependencies installed"

    # 6. Install project in dev mode
    _step "Installing project in development mode"
    "${REPO_ROOT}/.venv/bin/pip" install -e "${REPO_ROOT}" -q
    _ok "Project installed"

    # 7. Application setup (db init, admin user, directories)
    _step "Running application setup"
    ATENEA_SKIP_RUN_HINT=1 "${VENV_PY}" "${REPO_ROOT}/setup.py"
    _ok "Application setup complete"

    _ok "All done"
    _info "Run  ./atenea up               to start with Docker (auto-detects GPU)"
    _info "Run  ./atenea up --native       to run directly on the host"
    _info "Run  ./atenea up --nvidia|--amd to force a GPU mode"
}

_up() {
    local native=0
    local build=0
    local gpu_mode=""
    local args=()

    for arg in "$@"; do
        case "$arg" in
            --native)  native=1 ;;
            --build)   build=1 ;;
            --nvidia)  gpu_mode="nvidia" ;;
            --amd)     gpu_mode="amd" ;;
            --cpu)     gpu_mode="cpu" ;;
            *)         args+=("$arg") ;;
        esac
    done

    if [ "$native" -eq 1 ]; then
        _info "Starting Atenea natively (no Docker)"
        _setup
        exec "${REPO_ROOT}/.venv/bin/uvicorn" app:app --host 0.0.0.0 --port "${APP_PORT:-7000}" "${args[@]}"
        return
    fi

    [ "$build" -eq 1 ] && args+=(--build)
    GPU_MODE="$gpu_mode" _compose_cmd up -d "${args[@]}"

    _info "Atenea is running"
    _info "Open  http://localhost:${APP_PORT:-7000}  in your browser"
    _info "Run  ./atenea logs  to follow output"
}

_usage() {
    cat <<'USAGE'
Usage: ./atenea <command> [options]

Commands:
  setup                  First-time setup (venv, .env, deps)
  up [options]           Start Atenea (auto-detects GPU)
    --native               Run directly on host (no Docker)
    --build                Rebuild Docker image before starting
    --nvidia | --amd | --cpu   Force GPU mode (override auto-detect)
  down                   Stop all containers
  logs [options]         Follow container logs
  shell                  Open a shell in the running container
  exec <cmd...>          Run a command in the running container
  ps                     List running containers
  help                   Show this help

GPU auto-detection checks nvidia-smi (NVIDIA) and /dev/kfd (AMD).
Set GPU_MODE=nvidia|amd|cpu in .env to pin the mode.
USAGE
}

# ─── main dispatch ─────────────────────────────────────────────────────────────

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
    setup)             _setup "$@" ;;
    up)                _up "$@" ;;
    down|stop)         _compose_cmd down "$@" ;;
    logs)              _compose_cmd logs -f "$@" ;;
    shell)             _compose_cmd exec atenea bash "$@" ;;
    exec)              _compose_cmd exec atenea "$@" ;;
    ps)                _compose_cmd ps "$@" ;;
    help|--help|-h)    _usage ;;
    *)                 _fail "Unknown command: $cmd"; _usage; exit 1 ;;
esac
