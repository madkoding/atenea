#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
COMPOSE_BASE="docker/compose.yml"
COMPOSE_NVIDIA="docker/compose.gpu-nvidia.yml"
COMPOSE_AMD="docker/compose.gpu-amd.yml"

# ─── styling ───────────────────────────────────────────────────────────────────
C_INFO=$'\033[36m'
C_OK=$'\033[32m'
C_WARN=$'\033[33m'
C_FAIL=$'\033[31m'
C_STEP=$'\033[35m'
C_DIM=$'\033[2m'
C_BOLD=$'\033[1m'
C_RST=$'\033[0m'

_info()   { printf "${C_INFO}ℹ${C_RST}  %s\n" "$*"; }
_ok()     { printf "${C_OK}✔${C_RST}  %s\n" "$*"; }
_warn()   { printf "${C_WARN}⚠${C_RST}  %s\n" "$*"; }
_fail()   { printf "${C_FAIL}✘${C_RST}  %s\n" "$*"; }
_step()   { printf "\n${C_BOLD}${C_STEP}◆${C_RST}  ${C_BOLD}%s${C_RST}\n" "$*"; }
_dim()    { printf "${C_DIM}%s${C_RST}\n" "$*"; }
_sep()    { printf "${C_DIM}──────────────────────────────────────────${C_RST}\n"; }

# ─── spinner ───────────────────────────────────────────────────────────────────
_spin() {
    local msg="$1"; shift
    local spin='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    local i=0 start ms formatted out
    start=$(date +%s%N)
    out=$(mktemp)

    printf '\033[?25l'
    "$@" >"$out" 2>&1 &
    local pid=$!

    while kill -0 "$pid" 2>/dev/null; do
        printf '\r  \033[36m%s\033[0m  %s' "${spin:$i:1}" "$msg"
        i=$(( (i + 1) % ${#spin} ))
        sleep 0.08
    done

    local rc=0
    wait "$pid" 2>/dev/null || rc=$?
    printf '\033[?25h'

    ms=$(( ($(date +%s%N) - start) / 1000000 ))
    if [ "$ms" -ge 1000 ]; then
        formatted="$(awk "BEGIN{printf \"%.1fs\",$ms/1000}")"
    else
        formatted="${ms}ms"
    fi

    if [ "$rc" -eq 0 ]; then
        printf '\r  \033[32m✔\033[0m  %s  \033[2m(%s)\033[0m\n' "$msg" "$formatted"
    else
        printf '\r  \033[31m✘\033[0m  %s  \033[2m(%s)\033[0m\n' "$msg" "$formatted"
        [ -s "$out" ] && sed 's/^/    /' "$out"
        echo
    fi
    rm -f "$out"
    return "$rc"
}

# ─── core helpers ──────────────────────────────────────────────────────────────
_detect_gpu() {
    if command -v nvidia-smi &>/dev/null && nvidia-smi &>/dev/null; then
        echo "nvidia"
    elif [ -e /dev/kfd ]; then
        echo "amd"
    else
        echo "cpu"
    fi
}

_ensure_env() {
    if [ ! -f "${REPO_ROOT}/.env" ]; then
        _spin "Creating .env from .env.example" \
            cp "${REPO_ROOT}/.env.example" "${REPO_ROOT}/.env"
        _info "Edit .env to configure your instance"
    fi
}

_compose_cmd() {
    local action="$1"; shift
    local gpu; gpu="$(_detect_gpu)"
    local compose_args=()

    _ensure_env

    case "${GPU_MODE:-$gpu}" in
        nvidia) _info "GPU mode: NVIDIA"; compose_args+=(-f "${COMPOSE_NVIDIA}") ;;
        amd)    _info "GPU mode: AMD";    compose_args+=(-f "${COMPOSE_AMD}") ;;
        cpu)    _info "GPU mode: CPU";    compose_args+=(-f "${COMPOSE_BASE}") ;;
        *)
            _fail "Unknown GPU_MODE: ${GPU_MODE:-auto}. Use nvidia, amd, or cpu."
            return 1 ;;
    esac

    (cd "${REPO_ROOT}" && docker compose -p atenea "${compose_args[@]}" "$action" "$@")
}

# ─── subcommands ───────────────────────────────────────────────────────────────
_ensure_sysdeps() {
    local pkgs=()
    if ! python3 -c 'import ensurepip' &>/dev/null; then
        local py_ver
        py_ver="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
        pkgs+=("python${py_ver}-venv")
    fi
    if ! python3-config --include &>/dev/null 2>&1; then
        pkgs+=(python3-dev)
    fi
    if ! command -v gcc &>/dev/null; then
        pkgs+=(build-essential)
    fi
    if ! command -v git &>/dev/null; then
        pkgs+=(git)
    fi

    [ ${#pkgs[@]} -eq 0 ] && return

    _dim "Installing: ${pkgs[*]}"
    if command -v apt-get &>/dev/null; then
        sudo apt-get update -qq && sudo apt-get install -y -qq "${pkgs[@]}"
    elif command -v dnf &>/dev/null; then
        sudo dnf install -y -q "${pkgs[@]}"
    elif command -v pacman &>/dev/null; then
        sudo pacman -S --noconfirm "${pkgs[@]}"
    elif command -v zypper &>/dev/null; then
        sudo zypper install -y "${pkgs[@]}"
    elif command -v brew &>/dev/null; then
        brew install "${pkgs[@]}"
    else
        _warn "Unknown package manager — install manually: ${pkgs[*]}"
    fi
}

_setup() {
    _sep
    printf "${C_BOLD}${C_STEP}  Atenea Setup${C_RST}\n"
    _sep

    # ── 1. Python version ─────────────────────────────────────────────────────
    _step "1/6  Checking Python"
    if ! command -v python3 &>/dev/null; then
        _fail "python3 not found — install Python 3.12 first"
        exit 1
    fi
    py_version="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
    if [ "$py_version" != "3.12" ]; then
        _warn "Python 3.12 recommended (found $py_version) — continuing"
    else
        _ok "Python $py_version"
    fi

    # ── 2. System dependencies ────────────────────────────────────────────────
    _step "2/6  System dependencies"
    _ensure_sysdeps
    _ok "System dependencies ready"

    # ── 3. Environment file ───────────────────────────────────────────────────
    _step "3/6  Environment file"
    _ensure_env
    _ok "Environment ready"

    # ── 4. Virtual environment ────────────────────────────────────────────────
    _step "4/6  Python virtual environment"
    VENV_PY="${REPO_ROOT}/.venv/bin/python3"
    VENV_PIP="${REPO_ROOT}/.venv/bin/pip"
    if [ ! -f "$VENV_PIP" ] || [ ! -f "$VENV_PY" ]; then
        if [ -d "${REPO_ROOT}/.venv" ]; then
            _warn "Virtual environment is broken — rebuilding"
            rm -rf "${REPO_ROOT}/.venv"
        fi
        _spin "Creating virtual environment" python3 -m venv "${REPO_ROOT}/.venv"
    else
        _ok "Virtual environment exists"
    fi

    # ── 5. Python dependencies ────────────────────────────────────────────────
    _step "5/6  Python dependencies"
    _spin "Upgrading pip" "${VENV_PIP}" install --upgrade pip -q
    _spin "Installing core dependencies" "${VENV_PIP}" install -r "${REPO_ROOT}/requirements.txt" -q
    if [ -f "${REPO_ROOT}/requirements-optional.txt" ]; then
        _spin "Installing optional dependencies" "${VENV_PIP}" install -r "${REPO_ROOT}/requirements-optional.txt" -q
    fi
    _spin "Installing project in dev mode" "${VENV_PIP}" install -e "${REPO_ROOT}" -q

    # ── 6. Application setup ──────────────────────────────────────────────────
    _step "6/6  Application setup"
    if ATENEA_SKIP_RUN_HINT=1 "${VENV_PY}" "${REPO_ROOT}/app_setup.py"; then
        _ok "Application setup complete"
    else
        _fail "Application setup failed"
        return 1
    fi

    # ── done ──────────────────────────────────────────────────────────────────
    _sep
    _ok "Setup complete"
    _sep
    _info "Start the server:"
    _dim "  ./atenea up              (Docker, auto-detects GPU)"
    _dim "  ./atenea up --native     (directly on host)"
    echo
}

_up() {
    local native=0 build=0 gpu_mode="" args=()

    for arg in "$@"; do
        case "$arg" in
            --native)  native=1 ;;
            --build)   build=1 ;;
            --nvidia)  gpu_mode="nvidia" ;;
            --amd)     gpu_mode="amd" ;;
            --cpu)     gpu_mode="cpu" ;;
            *)         args+=("$arg") ;;
        esac
    done

    if [ "$native" -eq 1 ]; then
        _step "Starting Atenea natively"
        _setup
        exec "${REPO_ROOT}/.venv/bin/uvicorn" app:app --host 0.0.0.0 --port "${APP_PORT:-7000}" "${args[@]}"
        return
    fi

    [ "$build" -eq 1 ] && args+=(--build)
    GPU_MODE="$gpu_mode" _compose_cmd up -d "${args[@]}"

    _sep
    _ok "Atenea is running"
    _info "Open  ${C_BOLD}http://localhost:${APP_PORT:-7000}${C_RST}  in your browser"
    _info "Run   ./atenea logs  to follow output"
}

_usage() {
    _sep
    printf "${C_BOLD}${C_STEP}  atenea — CLI${C_RST}\n"
    _sep
    printf '\n'
    printf "  ${C_BOLD}Usage:${C_RST}  ${C_BOLD}./atenea <command>${C_RST} [options]\n"
    printf '\n'
    printf "  ${C_BOLD}Commands:${C_RST}\n"
    printf "    setup                  First-time setup (venv, .env, deps)\n"
    printf "    up [options]           Start Atenea (auto-detects GPU)\n"
    printf "      --native               Run directly on host (no Docker)\n"
    printf "      --build                Rebuild Docker image before starting\n"
    printf "      --nvidia | --amd | --cpu   Force GPU mode\n"
    printf '\n'
    printf "    down                   Stop all containers\n"
    printf "    logs [options]         Follow container logs\n"
    printf "    shell                  Open a shell in the running container\n"
    printf "    exec <cmd...>          Run a command in the running container\n"
    printf "    ps                     List running containers\n"
    printf "    help                   Show this help\n"
    printf '\n'
}

# ─── main dispatch ─────────────────────────────────────────────────────────────
cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
    setup)             _setup "$@" ;;
    up)                _up "$@" ;;
    down|stop)         _compose_cmd down "$@" ;;
    logs)              _compose_cmd logs -f "$@" ;;
    shell)             _compose_cmd exec atenea bash "$@" ;;
    exec)              _compose_cmd exec atenea "$@" ;;
    ps)                _compose_cmd ps "$@" ;;
    help|--help|-h)    _usage ;;
    *)                 _fail "Unknown command: $cmd"; _usage; exit 1 ;;
esac
